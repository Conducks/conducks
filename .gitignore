node_modules/
build/
*.log
.env*

# Storage directory (user data)
storage/
# Anchored: an unanchored `coverage/` matches at ANY depth, and it silently swallowed
# docs/modules/domain/analysis/coverage/MODULE.md — an authored doc, untracked for as long as the
# module has been named that. Test output lands at the repo root, so the anchor loses nothing.
/coverage/
# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
tests/fixtures
/data
# IDE
.vscode/
.idea/
*.swp
*.swo
*~

tests/fixtures/
# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/

# Temporary files
*.tmp
*.bak
*.swp
.cache/
dist/
# The vault is per-machine; the review-stamp store is NOT — a stamp is a shared assertion
# ("someone read this claim") and per-machine stamps would mean tier-2 rot detection exists only
# on the reviewer's laptop (ADR 0142). `dir/*` instead of `dir/` because git cannot re-include a
# file whose parent DIRECTORY is excluded.
.conducks/*
!.conducks/note-reviews.json
scratch/

# agent worktree scratch (47M, never commit)
.claude/

# Rust build output for plugins/checklist (todo74#P3) — Cargo.lock is committed,
# the compiled target/ tree is not, the same split every Cargo project makes.
/plugins/checklist/target/

# The checklist plugin's run file — ticks and notes, keyed to a build. Never
# committed: a tick recorded against one build looks like proof against
# another and is not (`conducks-visuals` §6b, ForgeTerm ADR 0035). Same entry
# ForgeTerm's own .gitignore carries, since this repo is also a project a
# ForgeTerm window can be pointed at.
docs/checklist-run.json
