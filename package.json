{
  "name": "conducks",
  "version": "0.7.7",
  "description": "High-fidelity structural intelligence and automated governance for AI agents. Transform your code into a living Synapse Graph.",
  "keywords": [
    "mcp",
    "static-analysis",
    "governance",
    "architecture",
    "dependency-graph",
    "ai-agents",
    "codebase-mapping"
  ],
  "author": "Conducks Team <contact@conducks.com>",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "conducks": "./build/src/interfaces/cli/index.js"
  },
  "files": [
    "build",
    "config",
    "scripts/check-native-parser.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && chmod +x build/src/interfaces/cli/index.js && cp package.json config/sentinel.json build/ && rm -rf build/src/resources && mkdir -p build/src/resources && cp -r src/resources/* build/src/resources/ && node scripts/copy-scm.mjs && node scripts/check-build-aliases.mjs && node scripts/check-declared-deps.mjs",
    "postinstall": "node scripts/check-native-parser.mjs",
    "start": "node ./build/src/interfaces/cli/index.js mirror",
    "demo": "npm run build && npm run start",
    "clean": "rm -rf build data .conducks",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "type-check": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:int": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "benchmark": "node tools/measure-pulse.mjs",
    "test:persistence": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects persistence",
    "bootstrap": "node scripts/bootstrap.mjs",
    "hooks": "git config core.hooksPath scripts/hooks && echo \"hooks installed: pre-commit runs conducks docs-lint\"",
    "postbuild": "node scripts/sync-skills-postbuild.mjs",
    "cli:smoke": "node tools/benchmark/cli-smoke.mjs",
    "oracle": "node tools/benchmark/oracle-tsc.mjs && node tools/benchmark/oracle-exports.mjs && node tools/benchmark/oracle-packs.mjs",
    "oracle:imports": "node tools/benchmark/oracle-tsc.mjs",
    "oracle:exports": "node tools/benchmark/oracle-exports.mjs",
    "oracle:python": "node tools/benchmark/oracle-python.mjs ../test-projects/scraper",
    "cli:mutate": "node tools/benchmark/mutate-cli-smoke.mjs",
    "test:fast": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.fast.config.js",
    "visuals": "node scripts/visuals/render.mjs && node scripts/visuals/detail.mjs && node scripts/visuals/notes.mjs",
    "oracle:packs": "node tools/benchmark/oracle-packs.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@toon-format/cli": "^1.0.0",
    "@toon-format/toon": "^1.0.0",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.3.2",
    "marked": "^5.1.2",
    "minimatch": "^9.0.9",
    "slugify": "^1.6.6"
  },
  "optionalDependencies": {
    "ajv": "^8.12.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-swift": "0.7.1",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.19.37",
    "cross-env": "^10.1.0",
    "elkjs": "^0.12.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conducks/conducks.git"
  },
  "homepage": "https://github.com/Conducks/conducks#readme",
  "bugs": {
    "url": "https://github.com/Conducks/conducks/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
